<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/main.css">
    <title>Mini-Message-Board</title>
</head>
<body>
    <nav>
        <h1 id="title">Welcome to the <%= title %>!</h1>
        <a href="/new" id="createPost">New Message</a>
    </nav>
        <ul id="messageContainer">
            <% messages.forEach(message => { %>
                <li class="message">User: <%= message.user %> </br> Posted: <%= message.added%> </br> <%= message.text %></li>
                <% }); %>
        </ul>
</body>
</html>